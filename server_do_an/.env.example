# ============================================
# JWT Configuration
# ============================================
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_change_this_in_production
JWT_REFRESH_EXPIRE=7d

# ============================================
# OTP Configuration
# ============================================
# Set to 'true' to enable real SMS via ESMS, 'false' for mock mode (accepts 000000)
OTP_ENABLED=false

# OTP expiration time in minutes
OTP_EXPIRE_MINUTES=5

# ============================================
# ESMS SMS Service Configuration (Vietnam)
# ============================================
# Get credentials from: https://esms.vn
# Required when OTP_ENABLED=true

# ESMS API Key
ESMS_API_KEY=your_esms_api_key_here

# ESMS Secret Key
ESMS_SECRET_KEY=your_esms_secret_key_here

# Brand name shown in SMS (max 11 characters)
ESMS_BRAND_NAME=P2PLending

# ============================================
# Database Configuration (MongoDB Atlas)
# ============================================
MONGODB_URI=mongodb+srv://truonggiang2299z:gzTwiKgl04tI2dFU@bt001.rpdv1gp.mongodb.net/p2p_do_an

# ============================================
# Google OAuth Configuration (Optional)
# ============================================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/google/redirect

# ============================================
# Server Configuration
# ============================================
PORT=3000
NODE_ENV=development
TIMEZONE=Asia/Ho_Chi_Minh

# ============================================
# Server Mode
# ============================================
DEV_MODE = true

# ============================================
# Phone Validation Configuration
# ============================================
PHONE_COUNTRY_CODE=+84

# ============================================
# Keycloak Configuration
# ============================================
KEYCLOAK_BASE_URL=http://118.69.41.95:9000
KEYCLOAK_REALM=fineract
KEYCLOAK_CLIENT_ID=community-app
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_API_TIMEOUT=30000

# ============================================
# CORS Configuration
# ============================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# ============================================
# Blockchain Configuration (Hyperledger Fabric)
# ============================================
# Set to 'true' to enable blockchain, 'false' for database-only mode
# NOTE: Interest rate is calculated from Fineract, not blockchain
BLOCKCHAIN_ENABLED=true

# ============================================
# Apache Fineract Configuration
# ============================================
# Set to 'true' to enable Fineract integration
FINERACT_ENABLED=true

# Set to 'true' to create loans on Fineract
FINERACT_LOAN_CREATION=true

# Fineract API URL
FINERACT_BASE_URL=http://118.69.41.95:8080

# Fineract tenant ID
FINERACT_TENANT_ID=default

# Fineract admin credentials
FINERACT_USERNAME=mifos
FINERACT_PASSWORD=password

# P2P Loan Product ID on Fineract
FINERACT_P2P_LOAN_PRODUCT_ID=1

# OAuth2 Client credentials (if using OAuth2)
FINERACT_OAUTH_CLIENT_ID=community-app
FINERACT_OAUTH_CLIENT_SECRET=123

# ============================================
# Loan Configuration
# ============================================
# Default credit score if not provided (FICO range: 300-850)
DEFAULT_CREDIT_SCORE=500

# Maximum days for disbursement date from today
MAX_DISBURSEMENT_DAYS=30

# Note price for investment units (VND)
NOTE_UNIT_PRICE=500000

# Admin spread percentage (fixed)
ADMIN_SPREAD_PERCENTAGE=3

# Interest rate calculation constants
RATE_FACTOR_CONSTANT=15
RATE_FICO_COEFFICIENT=0.00005
RATE_MONTH_COEFFICIENT=0.01


# Escrow Admin Account Configuration
FINERACT_ADMIN_CLIENT_ID=1
FINERACT_ESCROW_ACCOUNT_ID=1