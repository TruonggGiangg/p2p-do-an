PORT=5055
NODE_ENV=development
MEMORY_WEBHOOK_SECRET=change-this-secret

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4jpassword

# Vector (Qdrant + Embedding)
VECTOR_ENABLED=true
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=p2p_memory_chunks
EMBEDDING_PROVIDER=local-hash
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=384
OPENAI_API_KEY=
KEYWORD_WEIGHT=0.55
VECTOR_WEIGHT=0.45
GRAPH_WEIGHT=0.30
RRF_K=60
MIN_VECTOR_SCORE=0.15

# Answer generation (for POST /agent/answer)
ANSWER_PROVIDER=auto
ANSWER_MODEL=gpt-4o-mini
ANSWER_OPENAI_API_KEY=
ANSWER_GEMINI_MODEL=gemini-1.5-flash
ANSWER_GEMINI_API_KEY=
GEMINI_API_KEY=
ANSWER_MAX_CONTEXT_CHARS=12000
ANSWER_TEMPERATURE=0.1
ANSWER_TIMEOUT_MS=20000
ANSWER_TMP_DIR=./tmp/agent-answers
ANSWER_TMP_CLEANUP_ENABLED=true
ANSWER_TMP_TTL_SEC=86400
ANSWER_TMP_CLEANUP_INTERVAL_SEC=600

# Path project root to ingest
PROJECT_ROOT=/workspace

# File filters
INGEST_GLOB=**/*.{js,ts,tsx,jsx,json,md,yml,yaml}
EXCLUDE_GLOBS=**/node_modules/**,**/dist/**,**/build/**,**/.git/**,**/coverage/**
MAX_FILE_SIZE_BYTES=524288
CHUNK_SIZE_LINES=80
CHUNK_OVERLAP_LINES=10

# Auto ingest scheduler
AUTO_INGEST_ENABLED=false
AUTO_INGEST_INTERVAL_SEC=900
MASK_PII=true
METRIC_WINDOW_SIZE=200
