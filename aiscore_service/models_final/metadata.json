    "validation_split_csv": "/content/drive/MyDrive/Colab Notebooks/reports_final/splits/validation_split.csv",
    "test_split_csv": "/content/drive/MyDrive/Colab Notebooks/reports_final/splits/test_split.csv"
  },
  "split": {
    "train_rows": 29250,
    "validation_rows": 6750,
    "test_rows": 9000,
    "train_default_rate": 0.777778,
    "validation_default_rate": 0.777778,
    "test_default_rate": 0.777778
  },
  "config": {
    "random_state": 42,
    "test_size": 0.2,
    "val_size": 0.15,
    "xgb_n_estimators": 500,
    "xgb_max_depth": 4,
    "xgb_learning_rate": 0.05,
    "xgb_early_stopping_rounds": 35,
    "xgb_tree_method": "hist",
    "xgb_device_request": "auto",
    "xgb_resolved_device": "cpu",
    "permutation_importance_enabled": false
  }
}