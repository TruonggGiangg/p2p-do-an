{
  "version": "new_data_v1",
  "data_csv": "/content/drive/MyDrive/Colab Notebooks/loan_data.csv",
  "source_schema": "loan_data",
  "source_schema_info": {
    "note": "Input already uses the canonical loan_data schema."
  },
  "rows": 45000,
  "target": "is_default",
  "target_mode": "as_is",
  "positive_class": "Default",
  "negative_class": "Non-Default",
  "target_mapping": {
    "loan_status=1": "Default",
    "loan_status=0": "Non-Default",
    "is_default=1": "Default",
    "is_default=0": "Non-Default",
    "LendingClub Charged Off/Default/Late": "Default",
    "LendingClub Fully Paid": "Non-Default"
  },
  "target_note": "Default mode: loan_status=1 -> Default, loan_status=0 -> Non-Default. If your data uses loan_status=0 as Default, set TARGET_MODE_NEW_DATA=status_0_is_default.",
  "credit_score_normalization": {
    "source_column": "credit_score",
    "source_min": 390.0,
    "source_max": 850.0,
    "target_min": 150.0,
    "target_max": 750.0,
    "formula": "150 + (raw_score - source_min) * 600 / (source_max - source_min), clipped to 150-750"
  },
  "features": [
    "person_age",
    "person_income",
    "person_emp_exp",
    "loan_amnt",
    "loan_int_rate",
    "loan_percent_income",
    "cb_person_cred_hist_length",
    "credit_score",
    "previous_default_bin",
    "person_gender",
    "person_education",
    "person_home_ownership",
    "loan_intent"
  ],
  "required_raw_input_columns": [
    "person_age",
    "person_gender",
    "person_education",
    "person_income",
    "person_emp_exp",
    "person_home_ownership",
    "loan_amnt",
    "loan_intent",
    "loan_int_rate",
    "loan_percent_income",
    "cb_person_cred_hist_length",
    "credit_score",
    "previous_loan_defaults_on_file"
  ],
  "optional_runtime_input_columns": [
    "loan_term_months",
    "loan_monthly_payment_ratio"
  ],
  "term_feature_mode": "auto",
  "term_feature_trained": true,
  "term_feature_note": "Base XGBoost model is trained on all 45k loan_data.csv fields. loan_term_months is trained through term_adjuster.joblib from a real-term auxiliary dataset and applied as a PD logit adjustment at runtime.",
  "term_adjustment": {
    "enabled": true,
    "data_csv": "/content/drive/MyDrive/Colab Notebooks/financial_loan.csv",
    "source_schema": "lendingclub",
    "source_schema_info": {
      "note": "Mapped LendingClub-style data to the canonical AIScore schema with real term months.",
      "rows_dropped_unresolved_status": 1098,
      "default_statuses": [
        "charged off",
        "default",
        "does not meet the credit policy. status:charged off",
        "late (16-30 days)",
        "late (31-120 days)"
      ],
      "non_default_statuses": [
        "does not meet the credit policy. status:fully paid",
        "fully paid"
      ]
    },
    "rows": 37478,
    "features": [
      "loan_term_months",
      "loan_monthly_payment_ratio",
      "loan_percent_income",
      "loan_int_rate"
    ],
    "baseline_months": 36.0,
    "weight": 0.4,
    "payment_burden_guard": "If the requested term raises loan_monthly_payment_ratio above the 36-month baseline, runtime will not allow the term delta to reduce PD.",
    "metrics": {
      "roc_auc": 0.679028,
      "average_precision": 0.261293,
      "brier": 0.225786,
      "accuracy": 0.649146,
      "balanced_accuracy": 0.625837,
      "precision": 0.223754,
      "recall": 0.593252,
      "f1": 0.324949,
      "f2": 0.445963,
      "mcc": 0.181409,
      "ks": 0.267696
    },
    "note": "Auxiliary real-term model. Runtime applies the logit delta between requested term burden and baseline term burden to the 45k base PD, with a monotonic payment-burden guard for very short terms."
  },
  "term_adjustment_model_features": [
    "loan_term_months",
    "loan_monthly_payment_ratio",
    "loan_percent_income",
    "loan_int_rate"
  ],
  "raw_numeric_input_columns": [
    "person_age",
    "person_income",
    "person_emp_exp",
    "loan_amnt",
    "loan_int_rate",
    "loan_percent_income",
    "cb_person_cred_hist_length",
    "credit_score"
  ],
  "derived_model_features": [
    "previous_default_bin"
  ],
  "numeric_features": [
    "person_age",
    "person_income",
    "person_emp_exp",
    "loan_amnt",
    "loan_int_rate",
    "loan_percent_income",
    "cb_person_cred_hist_length",
    "credit_score",
    "previous_default_bin"
  ],
  "categorical_features": [
    "person_gender",
    "person_education",
    "person_home_ownership",
    "loan_intent"
  ],
  "explain_only_features": [],
  "processed_feature_names": [
    "person_age",
    "person_income",
    "person_emp_exp",
    "loan_amnt",
    "loan_int_rate",
    "loan_percent_income",
    "cb_person_cred_hist_length",
    "credit_score",
    "previous_default_bin",
    "person_gender_female",
    "person_gender_male",
    "person_education_Associate",
    "person_education_Bachelor",
    "person_education_Doctorate",
    "person_education_High School",
    "person_education_Master",
    "person_home_ownership_MORTGAGE",
    "person_home_ownership_OTHER",
    "person_home_ownership_OWN",
    "person_home_ownership_RENT",
    "loan_intent_DEBTCONSOLIDATION",
    "loan_intent_EDUCATION",
    "loan_intent_HOMEIMPROVEMENT",
    "loan_intent_MEDICAL",
    "loan_intent_PERSONAL",
    "loan_intent_VENTURE"
  ],
  "threshold": {
    "metric": "f2",
    "value": 0.15499999999999997
  },
  "metrics": {
    "roc_auc": 0.977218,
    "average_precision": 0.929912,
    "brier": 0.048366,
    "accuracy": 0.900222,
    "balanced_accuracy": 0.91175,
    "precision": 0.709665,
    "recall": 0.9325,
    "f1": 0.805964,
    "f2": 0.877399,
    "mcc": 0.752969,
    "ks": 0.826143
  },
  "risk_bands": [
    {
      "min_score": 700,
      "max_score": 750,
      "level": "Very low risk",
      "decision": "approve"
    },
    {
      "min_score": 650,
      "max_score": 699,
      "level": "Low risk",
      "decision": "approve"
    },
    {
      "min_score": 550,
      "max_score": 649,
      "level": "Medium risk",
      "decision": "manual_review"
    },
    {
      "min_score": 450,
      "max_score": 549,
      "level": "High risk",
      "decision": "manual_review"
    },
    {
      "min_score": 150,
      "max_score": 449,
      "level": "Very high risk",
      "decision": "reject_or_strict_review"
    }
  ],
  "outputs": {
    "model_dir": "/content/drive/MyDrive/Colab Notebooks/models_final",
    "chart_dir": "/content/drive/MyDrive/Colab Notebooks/charts_final",
    "report_dir": "/content/drive/MyDrive/Colab Notebooks/reports_final",
    "split_dir": "/content/drive/MyDrive/Colab Notebooks/reports_final/splits",
    "train_split_csv": "/content/drive/MyDrive/Colab Notebooks/reports_final/splits/train_split.csv",
    "validation_split_csv": "/content/drive/MyDrive/Colab Notebooks/reports_final/splits/validation_split.csv",
    "test_split_csv": "/content/drive/MyDrive/Colab Notebooks/reports_final/splits/test_split.csv"
  },
  "split": {
    "train_rows": 29250,
    "validation_rows": 6750,
    "test_rows": 9000,
    "train_default_rate": 0.222222,
    "validation_default_rate": 0.222222,
    "test_default_rate": 0.222222
  },
  "config": {
    "random_state": 42,
    "test_size": 0.2,
    "val_size": 0.15,
    "xgb_n_estimators": 500,
    "xgb_max_depth": 4,
    "xgb_learning_rate": 0.05,
    "xgb_early_stopping_rounds": 35,
    "xgb_tree_method": "hist",
    "xgb_device_request": "auto",
    "xgb_resolved_device": "cpu",
    "permutation_importance_enabled": false,
    "currency_invariant_mode": false
  }
}