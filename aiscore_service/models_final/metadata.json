      "decision": "manual_review"
    },
    {
      "min_score": 150,
      "max_score": 449,
      "level": "Very high risk",
      "decision": "reject_or_strict_review"
    }
  ],
  "outputs": {
    "model_dir": "/content/drive/MyDrive/Colab Notebooks/models_final",
    "chart_dir": "/content/drive/MyDrive/Colab Notebooks/charts_final",
