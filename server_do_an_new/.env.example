# ==================== BUSINESS DEFAULTS ====================
# Office & Form
DEFAULT_OFFICE_ID=1
DEFAULT_LEGAL_FORM_ID=1

# Localization
DEFAULT_LOCALE=en
DEFAULT_DATE_FORMAT=dd MMMM yyyy

# Savings Products IDs (Digital Wallet Only)
DEFAULT_EWALLET_PRODUCT_ID=1

# BNPL 2.0 Loan Settings (Mapping 1-N)
DEFAULT_BNPL_LOAN_PRODUCT_ID=5
