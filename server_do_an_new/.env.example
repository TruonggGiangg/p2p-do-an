# Environment Configuration Template
# Copy this file to .env and update with your actual values

# ==================== SERVER ====================
PORT=3001
NODE_ENV=development

# ==================== DATABASE ====================
MONGODB_URI=mongodb://localhost:27017/p2p_new
# For production, use MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database_name

# ==================== JWT ====================
JWT_SECRET=CHANGE_ME_TO_RANDOM_STRING_IN_PRODUCTION
JWT_EXPIRE=1h
JWT_REFRESH_SECRET=CHANGE_ME_TO_DIFFERENT_RANDOM_STRING
JWT_REFRESH_EXPIRE=7d

# ==================== FINERACT ====================
FINERACT_API_URL=http://localhost:8080/fineract-provider/api/v1
FINERACT_TENANT=default
FINERACT_USERNAME=mifos
FINERACT_PASSWORD=password

# ==================== KEYCLOAK ====================
KEYCLOAK_URL=http://localhost:9000
KEYCLOAK_REALM=fineract
KEYCLOAK_CLIENT_ID=community-app
KEYCLOAK_CLIENT_SECRET=CHANGE_ME_GET_FROM_KEYCLOAK_CONSOLE
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_ADMIN_REALM=master
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli

# ==================== DEFAULT VALUES ====================
DEFAULT_OFFICE_ID=1
DEFAULT_LEGAL_FORM_ID=1
DEFAULT_LOCALE=en
DEFAULT_DATE_FORMAT=dd MMMM yyyy
DEFAULT_CREDIT_WALLET_PRODUCT=CW01
DEFAULT_EWALLET_PRODUCT=EWALLET

# ==================== SECURITY ====================
CORS_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:8081
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=100
